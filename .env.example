# Salin file ini menjadi ".env" lalu isi nilainya.
# API key Gemini gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kunci rahasia guru (opsional). Guru yang memasukkan kunci ini di menu Tanya
# akan mendapat label "Guru" pada jawabannya dan bisa menghapus pertanyaan.
TEACHER_KEY=

PORT=3000
